<Page
    x:Name="SettingsPageRoot"
    x:Class="SyncLib.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SyncLib.App.Models"
    xmlns:viewmodels="using:SyncLib.App.ViewModels"
    xmlns:converters="using:SyncLib.App.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter" />
    </Page.Resources>

    <Grid Padding="32" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Configurações de Caminhos" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold"/>
            <TextBlock Text="Cadastre os diretórios nos discos externos para sincronização e mapeamento de biblioteca." Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
        </StackPanel>

        <!-- Card de Inserção de Novos Campos -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel Spacing="16">
                <!-- Linha 1: Caminho e Tipo -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <TextBox Header="Caminho Completo do Diretório" 
                             Text="{x:Bind ViewModel.InputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="Ex: E:\Mangas\Portugues"
                             Grid.Column="0"/>

                    <ComboBox Header="Tipo de Mídia" 
                              ItemsSource="{x:Bind ViewModel.MediaTypeOptions}" 
                              SelectedItem="{x:Bind ViewModel.SelectedMediaTypeOption, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              HorizontalAlignment="Stretch"
                              Grid.Column="1"/>
                </Grid>

                <!-- Linha 2: Descrição, Sufixo, Sub-pastas e Botão Inserir -->
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Header="Descrição" 
                             Text="{x:Bind ViewModel.InputDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="Ex: Coleção principal de Mangás"
                             Grid.Column="0"/>

                    <TextBox Header="Prefixo / Sufixo" 
                             Text="{x:Bind ViewModel.InputCustomSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="Ex: (Eng)"
                             Grid.Column="1"/>

                    <CheckBox Content="Sub-pastas" 
                              IsChecked="{x:Bind ViewModel.InputIncludesSubfolders, Mode=TwoWay}"
                              Grid.Column="2" 
                              VerticalAlignment="Bottom" 
                              Margin="0,0,0,6"/>

                    <Button Content="Inserir Caminho" 
                            Command="{x:Bind ViewModel.AddPathCommand}"
                            Style="{ThemeResource AccentButtonStyle}" 
                            Grid.Column="3" 
                            VerticalAlignment="Bottom" 
                            Height="36"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Grid de Caminhos Configurados -->
        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabeçalhos de Coluna -->
            <Grid Grid.Row="0" Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tipo" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Grid.Column="0"/>
                <TextBlock Text="Descrição" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Grid.Column="1"/>
                <TextBlock Text="Prefixo/Sufixo" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Grid.Column="2"/>
                <TextBlock Text="Caminho" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Grid.Column="3"/>
                <TextBlock Text="Sub-pastas" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" Grid.Column="4"/>
                <TextBlock Text="Status" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Grid.Column="5"/>
                <TextBlock Text="Ações" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" HorizontalAlignment="Center" Grid.Column="6"/>
            </Grid>

            <!-- Tabela ListView -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <ListView ItemsSource="{x:Bind ViewModel.ConfiguredPaths}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PathDisplayModel">
                            <Grid Padding="4,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{x:Bind MediaTypeDisplayName}" VerticalAlignment="Center" FontWeight="Medium" Grid.Column="0"/>
                                <TextBlock Text="{x:Bind Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Grid.Column="1"/>
                                <TextBlock Text="{x:Bind CustomSuffix}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Grid.Column="2"/>
                                <TextBlock Text="{x:Bind Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Grid.Column="3"/>
                                
                                <TextBlock Text="{x:Bind SubfoldersText}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Grid.Column="4"/>

                                <!-- Badge de Status -->
                                <Border Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="12" Padding="8,2" Background="{x:Bind StatusColor, Converter={StaticResource StringToBrushConverter}}">
                                    <TextBlock Text="{x:Bind StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>

                                <!-- Botão Excluir -->
                                <Button Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Command="{Binding DataContext.DeletePathCommand, ElementName=SettingsPageRoot}"
                                        CommandParameter="{x:Bind}"
                                        Style="{ThemeResource SubtleButtonStyle}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#EF4444"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <!-- Rodapé / Ações -->
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                       VerticalAlignment="Center" 
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" 
                       Grid.Column="0"/>

            <Button Content="Atualizar Status" 
                    Command="{x:Bind ViewModel.RefreshStatusesCommand}" 
                    Grid.Column="1"/>

            <Button Content="Salvar Configurações" 
                    Command="{x:Bind ViewModel.SaveSettingsCommand}" 
                    Style="{ThemeResource AccentButtonStyle}" 
                    Grid.Column="2"/>
        </Grid>
    </Grid>
</Page>

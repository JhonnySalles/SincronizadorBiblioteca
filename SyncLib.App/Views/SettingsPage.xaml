<Page
    x:Name="SettingsPageRoot"
    x:Class="SyncLib.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SyncLib.App.Models"
    xmlns:viewmodels="using:SyncLib.App.ViewModels"
    xmlns:converters="using:SyncLib.App.Converters"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="32" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Configurações de Caminhos" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold"/>
            <TextBlock Text="Cadastre os diretórios locais, pastas em rede (UNC) ou servidores FTP para sincronização e mapeamento." Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
        </StackPanel>

        <!-- Card de Inserção de Novos Campos -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel Spacing="16">
                <!-- Linha 1: Conexão, Caminho e Tipo de Mídia -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Header="Conexão" 
                              ItemsSource="{x:Bind ViewModel.ConnectionTypeOptions}" 
                              SelectedItem="{x:Bind ViewModel.SelectedConnectionTypeOption, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              HorizontalAlignment="Stretch"
                              Grid.Column="0"/>

                    <TextBox Header="Caminho / Diretório Raiz" 
                             Text="{x:Bind ViewModel.InputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="Ex: E:\Mangas ou /Mangas/Portugues"
                             Grid.Column="1"/>

                    <ComboBox Header="Tipo de Mídia" 
                              ItemsSource="{x:Bind ViewModel.MediaTypeOptions}" 
                              SelectedItem="{x:Bind ViewModel.SelectedMediaTypeOption, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              HorizontalAlignment="Stretch"
                              Grid.Column="2"/>
                </Grid>

                <!-- Linha 2 (Condicional FTP/Rede): Host, Porta, Usuário, Senha -->
                <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsNetworkOrFtpInput, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Header="Servidor / Host" 
                             Text="{x:Bind ViewModel.InputServerHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="Ex: ftp.meuservidor.com ou 192.168.1.100"
                             Grid.Column="0"/>

                    <TextBox Header="Porta" 
                             Text="{x:Bind ViewModel.InputServerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="21"
                             Grid.Column="1"/>

                    <TextBox Header="Usuário" 
                             Text="{x:Bind ViewModel.InputUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="Ex: anonymous ou usuario"
                             Grid.Column="2"/>

                    <PasswordBox Header="Senha" 
                                 Password="{x:Bind ViewModel.InputPassword, Mode=TwoWay}" 
                                 PlaceholderText="Senha de acesso"
                                 Grid.Column="3"/>
                </Grid>

                <!-- Linha 3: Descrição, Sufixo Arquivo, Sufixo Pasta, Extensões, Sub-pastas e Botão Inserir -->
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="135" />
                        <ColumnDefinition Width="135" />
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Header="Descrição" 
                             Text="{x:Bind ViewModel.InputDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="Ex: Coleção principal de Mangás"
                             Grid.Column="0"/>

                    <TextBox Header="Sufixo Arquivo" 
                             Text="{x:Bind ViewModel.InputCustomSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="Ex: [BR]"
                             Grid.Column="1"/>

                    <TextBox Header="Sufixo Pasta" 
                             Text="{x:Bind ViewModel.InputCustomFolderSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="Ex: (Novel)"
                             Grid.Column="2"/>

                    <TextBox Header="Extensões" 
                             ToolTipService.ToolTip="Separado por vírgula" 
                             Text="{x:Bind ViewModel.InputAllowedExtensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="Ex: .cbr, .cbz, epub"
                             Grid.Column="3"/>

                    <CheckBox Content="Sub-pastas" 
                              IsChecked="{x:Bind ViewModel.InputIncludesSubfolders, Mode=TwoWay}"
                              Grid.Column="4" 
                              VerticalAlignment="Bottom" 
                              Margin="0,0,0,6"/>

                    <Button Content="Inserir Caminho" 
                            Command="{x:Bind ViewModel.AddPathCommand}"
                            Style="{ThemeResource AccentButtonStyle}" 
                            Grid.Column="5" 
                            VerticalAlignment="Bottom" 
                            Height="36"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Grid de Caminhos Configurados -->
        <controls:DataGrid x:Name="ConfiguredPathsDataGrid"
                           Grid.Row="2"
                           ItemsSource="{x:Bind ViewModel.ConfiguredPaths, Mode=OneWay}"
                           AutoGenerateColumns="False"
                           CanUserResizeColumns="True"
                           CanUserSortColumns="True"
                           Sorting="ConfiguredPathsDataGrid_Sorting"
                           GridLinesVisibility="Horizontal"
                           HeadersVisibility="Column"
                           SelectionMode="Single"
                           RowHeight="44"
                           Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                           BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                           BorderThickness="1"
                           CornerRadius="8"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto">
            <controls:DataGrid.ColumnHeaderStyle>
                <Style TargetType="primitives:DataGridColumnHeader">
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Height" Value="40"/>
                    <Setter Property="SeparatorBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                </Style>
            </controls:DataGrid.ColumnHeaderStyle>
            <controls:DataGrid.Columns>
                <!-- Conexão -->
                <controls:DataGridTemplateColumn Header="Conexão" Tag="ConnectionType" Width="120" MinWidth="90" CanUserSort="True">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:PathDisplayModel">
                            <TextBlock Text="{x:Bind ConnectionTypeDisplayName, Mode=OneWay}" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <!-- Tipo de Mídia -->
                <controls:DataGridTemplateColumn Header="Tipo Mídia" Tag="MediaType" Width="140" MinWidth="100" CanUserSort="True">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:PathDisplayModel">
                            <TextBlock Text="{x:Bind MediaTypeDisplayName, Mode=OneWay}" VerticalAlignment="Center" Margin="12,0" FontWeight="Medium"/>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                    <controls:DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate x:DataType="models:PathDisplayModel">
                            <ComboBox ItemsSource="{Binding DataContext.MediaTypeOptions, ElementName=SettingsPageRoot}"
                                      SelectedValue="{Binding MediaType, Mode=TwoWay}"
                                      SelectedValuePath="Type"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellEditingTemplate>
                </controls:DataGridTemplateColumn>

                <!-- Descrição -->
                <controls:DataGridTextColumn Header="Descrição" Tag="Description" Width="160" MinWidth="120" CanUserSort="True"
                                             Binding="{Binding Description, Mode=TwoWay}"/>

                <!-- Sufixo Arquivo -->
                <controls:DataGridTextColumn Header="Sufixo Arquivo" Tag="CustomSuffix" Width="110" MinWidth="90" CanUserSort="True"
                                             Binding="{Binding CustomSuffix, Mode=TwoWay}"/>

                <!-- Sufixo Pasta -->
                <controls:DataGridTextColumn Header="Sufixo Pasta" Tag="CustomFolderSuffix" Width="110" MinWidth="90" CanUserSort="True"
                                             Binding="{Binding CustomFolderSuffix, Mode=TwoWay}"/>

                <!-- Extensões -->
                <controls:DataGridTextColumn Header="Extensões" Tag="AllowedExtensions" Width="120" MinWidth="90" CanUserSort="True"
                                             Binding="{Binding AllowedExtensions, Mode=TwoWay}"/>

                <!-- Servidor / Host -->
                <controls:DataGridTextColumn Header="Servidor/Host" Tag="ServerHost" Width="130" MinWidth="90" CanUserSort="True"
                                             Binding="{Binding ServerHost, Mode=TwoWay}"/>

                <!-- Caminho -->
                <controls:DataGridTextColumn Header="Caminho" Tag="Path" Width="*" MinWidth="160" CanUserSort="True"
                                             Binding="{Binding Path, Mode=TwoWay}"/>

                <!-- Sub-pastas -->
                <controls:DataGridCheckBoxColumn Header="Sub-pastas" Tag="IncludesSubfolders" Width="90" MinWidth="70" CanUserSort="True"
                                                 Binding="{Binding IncludesSubfolders, Mode=TwoWay}"/>

                <!-- Status -->
                <controls:DataGridTemplateColumn Header="Status" Tag="Status" Width="95" MinWidth="85" CanUserSort="True" IsReadOnly="True">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:PathDisplayModel">
                            <Border VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0" CornerRadius="12" Padding="8,2" Background="{x:Bind StatusColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}">
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <!-- Ações -->
                <controls:DataGridTemplateColumn Header="Ações" Width="70" MinWidth="60" IsReadOnly="True">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:PathDisplayModel">
                            <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Command="{Binding DataContext.DeletePathCommand, ElementName=SettingsPageRoot}"
                                    CommandParameter="{Binding}"
                                    Style="{ThemeResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#EF4444"/>
                            </Button>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- Rodapé / Ações -->
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                       VerticalAlignment="Center" 
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" 
                       Grid.Column="0"/>

            <Button Content="Atualizar Status" 
                    Command="{x:Bind ViewModel.RefreshStatusesCommand}" 
                    Grid.Column="1"/>

            <Button Content="Salvar Configurações" 
                    Command="{x:Bind ViewModel.SaveSettingsCommand}" 
                    Style="{ThemeResource AccentButtonStyle}" 
                    Grid.Column="2"/>
        </Grid>
    </Grid>
</Page>

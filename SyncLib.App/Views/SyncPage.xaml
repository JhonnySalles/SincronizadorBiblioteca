<Page
    x:Name="SyncPageRoot"
    x:Class="SyncLib.App.Views.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SyncLib.App.Models"
    xmlns:viewmodels="using:SyncLib.App.ViewModels"
    xmlns:converters="using:SyncLib.App.Converters"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <converters:StringToBrushConverter x:Key="StringToBrushConverter" />
        <converters:RowColorToActionIconBrushConverter x:Key="RowColorToActionIconBrushConverter" />
        <converters:RowColorToFolderIconBrushConverter x:Key="RowColorToFolderIconBrushConverter" />
    </Page.Resources>

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Topo: Lista Horizontal de Ícones de Status das Pastas + Botão Refresh -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Lista Horizontal de Pastas -->
            <ScrollViewer Grid.Column="0" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                <ListView ItemsSource="{x:Bind ViewModel.ConfiguredPaths}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="ConfiguredPath_ItemClick"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PathDisplayModel">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="20" 
                                    Padding="12,6"
                                    ToolTipService.ToolTip="Clique para abrir a pasta no Windows Explorer">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Ícone de Pasta -->
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />

                                    <!-- Descrição / Caminho -->
                                    <TextBlock Text="{x:Bind Description}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>

                                    <!-- Status (Bolinha Verde / Vermelha) -->
                                    <Ellipse Width="10" Height="10" Fill="{x:Bind StatusColor}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>

            <!-- Botão Refresh à Direita -->
            <Button Grid.Column="1" Command="{x:Bind ViewModel.LoadConfiguredPathsCommand}" ToolTipService.ToolTip="Atualizar status das pastas">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock Text="Atualizar"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. Seleção do Tipo de Processo e Label de Caminhos Configurados -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Header="Tipo do Processo" 
                              ItemsSource="{x:Bind ViewModel.MediaTypeOptions}" 
                              SelectedItem="{x:Bind ViewModel.SelectedMediaTypeOption, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              HorizontalAlignment="Stretch"
                              Grid.Column="0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4" Spacing="2">
                        <TextBlock Text="Destinos Configurados para este Tipo:" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.DestinationPathsText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Botões de Ação: Analisar e Processar -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Command="{x:Bind ViewModel.AnalyzeLibrariesCommand}" 
                    VerticalAlignment="Center"
                    Height="36"
                    Grid.Column="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                    <TextBlock Text="Analisar"/>
                </StackPanel>
            </Button>

            <Button Command="{x:Bind ViewModel.ProcessSyncCommand}" 
                    Style="{ThemeResource AccentButtonStyle}"
                    VerticalAlignment="Center"
                    Height="36"
                    Grid.Column="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                    <TextBlock Text="Processar"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 4. Grid de Arquivos para Sincronização -->
        <Grid Grid.Row="3">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                <controls:DataGrid ItemsSource="{x:Bind ViewModel.SyncItems}"
                                   AutoGenerateColumns="False"
                                   CanUserResizeColumns="True"
                                   CanUserSortColumns="True"
                                   GridLinesVisibility="Horizontal"
                                   HeadersVisibility="Column"
                                   RowBackground="Transparent"
                                   SelectionMode="Single"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   MinColumnWidth="60"
                                   ClipboardCopyMode="None"
                                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                                   CornerRadius="8">
                    <controls:DataGrid.ColumnHeaderStyle>
                        <Style TargetType="primitives:DataGridColumnHeader">
                            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="SeparatorBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        </Style>
                    </controls:DataGrid.ColumnHeaderStyle>
                    <controls:DataGrid.Columns>
                        <!-- Status (Bolinha) -->
                        <controls:DataGridTemplateColumn Width="40" MinWidth="35">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:SyncItemModel">
                                    <Border Background="{x:Bind RowColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}"
                                            Padding="4">
                                        <Ellipse Width="10" Height="10" 
                                                 Fill="{x:Bind StatusDotColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}" 
                                                 HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <!-- Coluna 1: Biblioteca de Origem -->
                        <controls:DataGridTemplateColumn Header="Biblioteca de Origem" Width="180" MinWidth="140" CanUserSort="True">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:SyncItemModel">
                                    <Border Background="{x:Bind RowColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}"
                                            ToolTipService.ToolTip="{x:Bind SourceFilePath, Mode=OneWay}"
                                            Padding="12,6">
                                        <TextBlock Text="{x:Bind SourceLibraryName}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <!-- Coluna 2: Arquivo de Origem -->
                        <controls:DataGridTemplateColumn Header="Arquivo de Origem" Width="300" MinWidth="200" CanUserSort="True">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:SyncItemModel">
                                    <Border Background="{x:Bind RowColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}"
                                            ToolTipService.ToolTip="{x:Bind SourceFilePath, Mode=OneWay}"
                                            Padding="12,6">
                                        <TextBlock Text="{x:Bind SourceFileName}" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <!-- Coluna 3: Biblioteca de Destino -->
                        <controls:DataGridTemplateColumn Header="Biblioteca de Destino" Width="180" MinWidth="140" CanUserSort="True">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:SyncItemModel">
                                    <Border Background="{x:Bind RowColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}"
                                            ToolTipService.ToolTip="{x:Bind DestinationFolderPath, Mode=OneWay}"
                                            Padding="12,6">
                                        <TextBlock Text="{x:Bind DestinationLibraryName}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <!-- Coluna 4: Pasta de Destino -->
                        <controls:DataGridTemplateColumn Header="Pasta de Destino" Width="*" MinWidth="250" CanUserSort="True">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:SyncItemModel">
                                    <Border Background="{x:Bind RowColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}"
                                            ToolTipService.ToolTip="{x:Bind DestinationFolderPath, Mode=OneWay}"
                                            Padding="12,6">
                                        <TextBlock Text="{x:Bind DestinationFolderPath}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <!-- Coluna 5: Ações -->
                        <controls:DataGridTemplateColumn Header="Ações" Width="80" MinWidth="70">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:SyncItemModel">
                                    <Border Background="{x:Bind RowColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}"
                                            Padding="4">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                            <!-- Botão Excluir da Fila -->
                                            <Button Click="RemoveItem_Click"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    Padding="4"
                                                    ToolTipService.ToolTip="Remover da lista de sincronização">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{x:Bind RowColor, Mode=OneWay, Converter={StaticResource RowColorToActionIconBrushConverter}}"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
            </Border>

            <!-- Mensagem quando a lista estiver vazia -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False"
                        Visibility="{x:Bind ViewModel.SyncItems.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock Text="Clique em 'Analisar' para comparar as bibliotecas" 
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                           FontWeight="Medium"/>
            </StackPanel>
        </Grid>

        <!-- 5. Rodapé / Status + Barra de Progresso + Botões -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6" Margin="0,0,16,0">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                <ProgressBar Minimum="0" 
                             Maximum="{x:Bind ViewModel.ProgressTotal, Mode=OneWay}" 
                             Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" 
                             Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay}" 
                             Height="4" 
                             HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Button Content="Limpar Lista" 
                        Command="{x:Bind ViewModel.ClearSyncItemsCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

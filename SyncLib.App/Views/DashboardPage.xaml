<Page
    x:Name="DashboardPageRoot"
    x:Class="SyncLib.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SyncLib.App.Models"
    xmlns:viewmodels="using:SyncLib.App.ViewModels"
    xmlns:converters="using:SyncLib.App.Converters"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <converters:StringToBrushConverter x:Key="StringToBrushConverter" />
    </Page.Resources>

    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Topo: Lista Horizontal de Ícones de Status das Pastas + Botão Refresh -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Lista Horizontal de Pastas -->
            <ScrollViewer Grid.Column="0" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                <ItemsControl ItemsSource="{x:Bind ViewModel.ConfiguredPaths}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PathDisplayModel">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="20" 
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Ícone de Pasta -->
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />

                                    <!-- Descrição / Caminho -->
                                    <TextBlock Text="{x:Bind Description}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>

                                    <!-- Status (Bolinha Verde / Vermelha) -->
                                    <Ellipse Width="10" Height="10" Fill="{x:Bind StatusColor}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Botão Refresh à Direita -->
            <Button Grid.Column="1" Command="{x:Bind ViewModel.LoadConfiguredPathsCommand}" ToolTipService.ToolTip="Atualizar status das pastas">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock Text="Atualizar"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. Seleção do Tipo de Processo e Label de Caminhos Configurados -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Header="Tipo do Processo" 
                              ItemsSource="{x:Bind ViewModel.MediaTypeOptions}" 
                              SelectedItem="{x:Bind ViewModel.SelectedMediaTypeOption, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              HorizontalAlignment="Stretch"
                              Grid.Column="0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,4" Spacing="2">
                        <TextBlock Text="Destinos Configurados para este Tipo:" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.DestinationPathsText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Campo de Busca de Arquivo -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Header="Localizar Arquivo / Digitar Caminho" 
                     Text="{x:Bind ViewModel.SearchPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     PlaceholderText="Cole ou digite o caminho do arquivo ou pasta..."
                     Grid.Column="0"/>

            <Button Content="Adicionar Arquivos" 
                    Command="{x:Bind ViewModel.AddFilesFromPathCommand}" 
                    VerticalAlignment="Bottom"
                    Height="36"
                    Grid.Column="1"/>

            <Button Content="Buscar Arquivo" 
                    Click="OpenFilePicker_Click" 
                    Style="{ThemeResource AccentButtonStyle}"
                    VerticalAlignment="Bottom"
                    Height="36"
                    Grid.Column="2"/>
        </Grid>

        <!-- 4. Drag & Drop Area + Grid de Arquivos -->
        <Grid Grid.Row="3" AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                <controls:DataGrid ItemsSource="{x:Bind ViewModel.PendingFiles}"
                                   AutoGenerateColumns="False"
                                   CanUserResizeColumns="True"
                                   CanUserSortColumns="True"
                                   GridLinesVisibility="Horizontal"
                                   HeadersVisibility="Column"
                                   RowBackground="Transparent"
                                   SelectionMode="Single"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   MinColumnWidth="60"
                                   ClipboardCopyMode="None"
                                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                                   CornerRadius="8">
                    <controls:DataGrid.ColumnHeaderStyle>
                        <Style TargetType="primitives:DataGridColumnHeader">
                            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="SeparatorBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        </Style>
                    </controls:DataGrid.ColumnHeaderStyle>
                    <controls:DataGrid.Columns>
                        <!-- Coluna 1: Arquivo de Origem -->
                        <controls:DataGridTemplateColumn Header="Arquivo de Origem" Width="250" MinWidth="180" CanUserSort="True">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:FileItemModel">
                                    <Border Background="{x:Bind RowColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}"
                                            ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}"
                                            Padding="12,6">
                                        <TextBlock Text="{x:Bind FileName}" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <!-- Coluna 2: Nome Final no Destino (Editável) -->
                        <controls:DataGridTemplateColumn Header="Nome Final no Destino" Width="300" MinWidth="220">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:FileItemModel">
                                    <Border Background="{x:Bind RowColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}"
                                            ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}"
                                            Padding="8,4">
                                        <TextBox Text="{x:Bind FinalFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 VerticalAlignment="Center" 
                                                 FontSize="13"/>
                                    </Border>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <!-- Coluna 3: Pasta de Destino (Editável + Picker) -->
                        <controls:DataGridTemplateColumn Header="Pasta de Destino" Width="280" MinWidth="180" CanUserSort="True">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:FileItemModel">
                                    <Border Background="{x:Bind RowColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}"
                                            ToolTipService.ToolTip="{x:Bind TargetDirectory, Mode=OneWay}"
                                            Padding="8,4">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{x:Bind DisplayTargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     VerticalAlignment="Center" 
                                                     FontSize="13"/>
                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.SelectCustomFolderCommand, ElementName=DashboardPageRoot}"
                                                    CommandParameter="{x:Bind}"
                                                    Style="{ThemeResource SubtleButtonStyle}"
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Selecionar outra pasta de destino">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <!-- Coluna 4: Tipo -->
                        <controls:DataGridTemplateColumn Header="Tipo" Width="150" MinWidth="100">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:FileItemModel">
                                    <Border Background="{x:Bind RowColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}"
                                            ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}"
                                            Padding="12,6">
                                        <TextBlock Text="{x:Bind MediaTypeDisplayName}" VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}"/>
                                    </Border>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>

                        <!-- Coluna 5: Ações -->
                        <controls:DataGridTemplateColumn Header="Ações" Width="70" MinWidth="60">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:FileItemModel">
                                    <Border Background="{x:Bind RowColor, Mode=OneWay, Converter={StaticResource StringToBrushConverter}}"
                                            Padding="4">
                                        <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemovePendingFileCommand, ElementName=DashboardPageRoot}"
                                                CommandParameter="{x:Bind}"
                                                Style="{ThemeResource SubtleButtonStyle}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#EF4444"/>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
            </Border>

            <!-- Dica Visual de Drag & Drop quando a lista estiver vazia -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False"
                        Visibility="{x:Bind ViewModel.PendingFiles.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                <FontIcon Glyph="&#xC19C;" FontSize="36" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock Text="Arraste e solte os arquivos aqui para adicionar à fila" 
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                           FontWeight="Medium"/>
            </StackPanel>
        </Grid>

        <!-- 5. Rodapé / Status + Botão Copiar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                       VerticalAlignment="Center" 
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" 
                       Grid.Column="0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Button Content="Limpar Fila" 
                        Command="{x:Bind ViewModel.ClearPendingFilesCommand}" />

                <Button Command="{x:Bind ViewModel.CopyFilesCommand}" 
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                        <TextBlock Text="Copiar"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

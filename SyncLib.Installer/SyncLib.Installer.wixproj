<Project Sdk="WixToolset.Sdk/4.0.3">
  <PropertyGroup>
    <OutputName>SyncLibSetup</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <Cultures>pt-BR;en-US</Cultures>
    <SuppressIces>ICE03</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.3" />
    <PackageReference Include="WixToolset.Heat" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <BindPath Include="..\Executavel" />
  </ItemGroup>

  <ItemGroup>
    <HarvestDirectory Include="..\Executavel">
      <ComponentGroupName>AppHarvestedComponents</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
  </ItemGroup>
</Project>
